[Unit]
Description=Astralignment authoritative two-G1 MuJoCo world
After=network.target

[Service]
Type=simple
User=astra
Group=astra
WorkingDirectory=/opt/astra
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/astra/.venv/bin/python -m sim.server
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/astra/artifacts /opt/astra/runtime

[Install]
WantedBy=multi-user.target

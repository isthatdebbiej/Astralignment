NODE_ENV=production
PORT=8787
PUBLIC_ORIGIN=https://astra.example.com
SIM_URL=http://127.0.0.1:8001
# Configure on the server only; never commit or expose through a VITE_ variable.
OPENAI_API_KEY=
ASTRA_BUDGET_USD=80
# Required by gateway on public hosts. Set a strong private operator token locally.
ASTRA_OPERATOR_TOKEN=
# JSON array; empty means LAN-only connectivity. Add your authorized STUN/TURN service.
# TURN credentials are browser-visible by WebRTC design; prefer short-lived credentials.
CAMERA_ICE_SERVERS=[]

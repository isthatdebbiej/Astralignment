{
  "name": "astralignment",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n gateway,web \"npm:dev:gateway\" \"npm:dev:web\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:gateway": "tsx watch gateway/index.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "start": "tsx gateway/index.ts",
    "test": "tsx --test tests/gateway/*.test.ts web/src/product/*.test.ts"
  },
  "dependencies": {
    "@mcap/core": "^2.2.2",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.2.0",
    "express": "^5.1.0",
    "http-proxy": "^1.18.1",
    "lucide-react": "^0.468.0",
    "openai": "^6.0.0",
    "qrcode": "^1.5.4",
    "quickjs-emscripten": "^0.32.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0",
    "tsx": "^4.20.0",
    "vite": "^6.3.0",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.0",
    "@types/http-proxy": "^1.17.16",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.0",
    "typescript": "^5.8.0"
  }
}

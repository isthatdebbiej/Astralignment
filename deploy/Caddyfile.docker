{$ASTRA_HOSTNAME} {
  encode zstd gzip
  @gateway path /api/* /ws/*
  handle @gateway {
    reverse_proxy gateway:8787
  }
  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }
  header {
    Referrer-Policy "no-referrer"
    Permissions-Policy "camera=(self), microphone=()"
    X-Content-Type-Options "nosniff"
  }
}

FROM node:22.16.0-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json vite.config.ts ./
COPY contracts ./contracts
COPY gateway ./gateway
COPY web ./web
COPY tests ./tests
RUN npm run build
ENV CURATION_DATA_DIR=/data CURATION_SOURCE_ROOT=/sources CURATION_AUTO_WORKER=0 CURATION_CONTAINER_LOCAL=1
EXPOSE 8788
CMD ["node","--import","tsx","gateway/curation/server.ts"]

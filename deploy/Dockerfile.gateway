FROM node:22-bookworm-slim
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY gateway ./gateway
COPY contracts ./contracts
RUN mkdir runtime artifacts && chown -R node:node runtime artifacts
USER node
ENV NODE_ENV=production HOST=0.0.0.0 PORT=8787
CMD ["node", "--import", "tsx", "gateway/index.ts"]
